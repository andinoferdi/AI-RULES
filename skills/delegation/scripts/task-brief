#!/usr/bin/env bash
# Wrapper for task_brief.py
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  python3 "${SCRIPT_DIR}/task_brief.py" "$@"
elif command -v python >/dev/null 2>&1; then
  python "${SCRIPT_DIR}/task_brief.py" "$@"
else
  echo "Error: Python 3 is required for task-brief" >&2
  exit 2
fi
