#!/usr/bin/env bash
# Wrapper for delegation_workspace.py
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  python3 "${SCRIPT_DIR}/delegation_workspace.py" "$@"
elif command -v python >/dev/null 2>&1; then
  python "${SCRIPT_DIR}/delegation_workspace.py" "$@"
else
  echo "Error: Python 3 is required for delegation-workspace" >&2
  exit 2
fi
