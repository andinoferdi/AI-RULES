#!/usr/bin/env bash
# Wrapper for ticket_graph.py
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  python3 "${SCRIPT_DIR}/ticket_graph.py" "$@"
elif command -v python >/dev/null 2>&1; then
  python "${SCRIPT_DIR}/ticket_graph.py" "$@"
else
  echo "Error: Python 3 is required for ticket-graph" >&2
  exit 2
fi
