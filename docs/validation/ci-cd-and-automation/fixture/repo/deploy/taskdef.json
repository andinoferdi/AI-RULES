{
  "family": "orders-api-__ENV__",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/orders-api-execution",
  "taskRoleArn": "arn:aws:iam::123456789012:role/orders-api-__ENV__-task",
  "containerDefinitions": [
    {
      "name": "orders-api",
      "image": "__IMAGE__",
      "portMappings": [{ "containerPort": 8080 }],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-1:123456789012:secret:orders/__ENV__/database-url"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://localhost:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 10,
        "retries": 3
      }
    }
  ]
}
