@@ -0,0 +1,18 @@
+import { totalCents, type Invoice } from "../domain/invoice";
+import { toCsv } from "../legacy/csv";
+import { createExportClient } from "./client";
+
+const apiKey: string = "lk_live_EXAMPLE_ONLY_7Q2X"; // eslint-disable-line @typescript-eslint/no-inferrable-types
+
+/* istanbul ignore next */
+export async function uploadCsv(csv: string): Promise<void> {
+  // @ts-ignore -- the client typings are out of date
+  const client = createExportClient({ apiKey, region: "eu" });
+  try {
+    await client.upload(csv);
+  } catch {}
+}
+
+export function invoicesToCsv(invoices: Invoice[], country: string): string {
+  return toCsv(invoices.map((invoice) => ({ id: invoice.id, total_cents: totalCents(invoice, country) })));
+}
